# ==========================================
# CONFIGURAÇÃO DOS AMBIENTES
# ==========================================
@URL_LOCAL = http://localhost:3000
@URL_RAILWAY = https://seu-projeto.up.railway.app

# Defina o ambiente ativo
@URL = {{URL_LOCAL}}

### ==========================================
### 1. STATUS DA API
### ==========================================
GET {{URL}}/

### ==========================================
### 2. USUÁRIOS E AUTENTICAÇÃO
### ==========================================

### 2.1. Cadastrar Usuário Cliente 1
POST {{URL}}/usuario
Content-Type: application/json

{
  "nome": "João Ferreira",
  "email": "joao.leitor@email.com",
  "senha": "123",
  "cpf": "12345678901",
  "tipo": "CLIENTE"
}

### 2.2. Cadastrar Usuário Cliente 2
POST {{URL}}/usuario
Content-Type: application/json

{
  "nome": "Maria Santos",
  "email": "maria.devocional@email.com",
  "senha": "123",
  "cpf": "98765432100",
  "tipo": "CLIENTE"
}

### 2.3. Cadastrar Usuário Admin
POST {{URL}}/usuario
Content-Type: application/json

{
  "nome": "Administrador Livraria",
  "email": "admin@livraria.com",
  "senha": "admin",
  "cpf": "11122233344",
  "tipo": "ADMIN"
}

### 2.4. Realizar Login
POST {{URL}}/login
Content-Type: application/json

{
  "email": "joao.leitor@email.com",
  "senha": "123"
}

### 2.5. Listar Todos os Usuários
GET {{URL}}/usuarios?statusLog=true

### 2.6. Consultar Usuário por ID
GET {{URL}}/usuario/1?statusLog=true

### 2.7. Atualizar Usuário
PUT {{URL}}/usuario/1?statusLog=true
Content-Type: application/json

{
  "nome": "João Ferreira Silva",
  "email": "joao.leitor@email.com",
  "senha": "123",
  "cpf": "12345678901",
  "tipo": "CLIENTE"
}

### 2.8. Deletar Usuário (Ex: ID 2)
DELETE {{URL}}/usuario/2?statusLog=true


### ==========================================
### 3. CATEGORIAS DE BÍBLIAS
### ==========================================

### 3.1. Cadastrar Categoria 1 (Bíblias de Estudo)
POST {{URL}}/categoria?statusLog=true
Content-Type: application/json

{
  "nome": "Bíblias de Estudo",
  "descricao": "Contém notas explicativas, mapas, concordância e artigos teológicos."
}

### 3.2. Cadastrar Categoria 2 (Devocionais e Femininas)
POST {{URL}}/categoria?statusLog=true
Content-Type: application/json

{
  "nome": "Devocionais e Femininas",
  "descricao": "Bíblias com plano de leitura diária e edições especiais."
}

### 3.3. Cadastrar Categoria 3 (Infantis)
POST {{URL}}/categoria?statusLog=true
Content-Type: application/json

{
  "nome": "Bíblias Infantis",
  "descricao": "Linguagem simplificada e ilustrações para crianças."
}

### 3.4. Listar Categorias
GET {{URL}}/categorias

### 3.5. Consultar Categoria por ID
GET {{URL}}/categoria/1

### 3.6. Atualizar Categoria
PUT {{URL}}/categoria/1?statusLog=true
Content-Type: application/json

{
  "nome": "Bíblias de Estudo e Teológicas",
  "descricao": "Contém comentários avançados, exegese, mapas e gráficos."
}


