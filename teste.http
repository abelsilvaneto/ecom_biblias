# ==========================================
# CONFIGURAÇÃO DOS AMBIENTES
# ==========================================
@URL_LOCAL = http://localhost:3000
@URL_RAILWAY = https://seu-projeto.up.railway.app

# Escolha qual ambiente testar alterando a variável abaixo nas requisições
@URL = {{URL_LOCAL}}
# @URL = {{URL_RAILWAY}}

### ==========================================
### 1. TESTE DE STATUS DA API
### ==========================================
GET {{URL}}/


### ==========================================
### 2. CADASTRO DE USUÁRIOS (3 Usuários)
### ==========================================

### 2.1. Cadastrar Usuário 1
POST {{URL}}/usuario
Content-Type: application/json

{
  "nome": "João Silva",
  "email": "joao@email.com",
  "senha": "123",
  "cpf": "12345678901"
}

### 2.2. Cadastrar Usuário 2
POST {{URL}}/usuario
Content-Type: application/json

{
  "nome": "Maria Oliveira",
  "email": "maria@email.com",
  "senha": "456",
  "cpf": "98765432100"
}

### 2.3. Cadastrar Usuário 3
POST {{URL}}/usuario
Content-Type: application/json

{
  "nome": "Carlos Souza",
  "email": "carlos@email.com",
  "senha": "789",
  "cpf": "11122233344"
}


### ==========================================
### 3. AUTENTICAÇÃO (LOGIN)
### ==========================================

### 3.1. Realizar Login
POST {{URL}}/login
Content-Type: application/json

{
  "email": "joao@email.com",
  "senha": "123"
}


### ==========================================
### 4. CONSULTAS E OPERAÇÕES DE USUÁRIOS
### ==========================================

### 4.1. Listar Usuários (Autenticado)
GET {{URL}}/usuarios?statusLog=true

### 4.2. Consultar Usuário por ID (ID 1)
GET {{URL}}/usuario/1?statusLog=true

### 4.3. Atualizar Usuário (ID 1)
PUT {{URL}}/usuario/1?statusLog=true
Content-Type: application/json

{
  "nome": "João Silva Alterado",
  "email": "joao.novo@email.com",
  "senha": "123",
  "cpf": "12345678901"
}

### 4.4. Apagar Usuário (ID 3)
DELETE {{URL}}/usuario/3?statusLog=true


### ==========================================
### 5. CATEGORIAS
### ==========================================

### 5.1. Cadastrar Categoria
POST {{URL}}/categoria?statusLog=true
Content-Type: application/json

{
  "nome": "Periféricos",
  "descricao": "Teclados, mouses e acessórios"
}

### 5.2. Listar Categorias (Público)
GET {{URL}}/categorias

### 5.3. Consultar Categoria por ID (Público)
GET {{URL}}/categoria/1

### 5.4. Atualizar Categoria
PUT {{URL}}/categoria/1?statusLog=true
Content-Type: application/json

{
  "nome": "Periféricos e Acessórios",
  "descricao": "Teclados, mouses, headsets e acessórios"
}


