Authorization: Bearer {{TOKEN}}
Content-Type: application/json

{
  "titulo": "Bíblia de Estudo de Genebra - Edição de Luxo",
  "traducao": "ARA (Almeida Revista e Atualizada)",
  "preco": 199.90,
